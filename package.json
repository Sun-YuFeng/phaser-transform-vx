{
  "name": "template-vite",
  "description": "A Phaser 3 template using Vite.",
  "version": "1.4.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phaserjs/template-vite.git"
  },
  "author": "Phaser Studio <support@phaser.io> (https://phaser.io/)",
  "license": "MIT",
  "licenseUrl": "http://www.opensource.org/licenses/mit-license.php",
  "bugs": {
    "url": "https://github.com/phaserjs/template-vite/issues"
  },
  "homepage": "https://github.com/phaserjs/template-vite#readme",
  "scripts": {
    "dev": "node log.js dev & vite --config vite/config.dev.mjs",
    "dev:wx": "vite --config vite/config.dev.mjs --host 127.0.0.1 --port 8080",
    "build": "node log.js build & vite build --config vite/config.prod.mjs",
    "dev-nolog": "vite --config vite/config.dev.mjs",
    "build-nolog": "vite build --config vite/config.prod.mjs",
    "copy:wx-assets": "node scripts/copy-wx-assets.mjs",
    "clean:public": "node scripts/clean-public-assets.mjs",
    "build:wx": "node scripts/copy-wx-assets.mjs && vite build --config vite/config.wx.mjs",
    "init:wx": "node scripts/init-wx-project.mjs",
    "extract": "node scripts/extract-runtime.mjs",
    "archive:game": "node scripts/archive-game.mjs",
    "finish:game": "node scripts/finish-game.mjs",
    "probe:output": "node scripts/probe-output.mjs",
    "probe:phaser2": "node scripts/probe-phaser2-html.mjs",
    "extract:phaser2": "node scripts/extract-phaser2-html.mjs",
    "copy:wx-phaser2": "node scripts/copy-wx-phaser2-libs.mjs",
    "build:wx:phaser2": "node scripts/copy-wx-phaser2-libs.mjs",
    "init:wx:phaser2": "node scripts/init-wx-project.mjs --template phaser2.3.0"
  },
  "devDependencies": {
    "jszip": "^3.10.1",
    "terser": "^5.39.0",
    "vite": "^6.3.1",
    "weapp-adapter": "^1.0.0"
  },
  "dependencies": {
    "phaser": "3.90.0"
  }
}
